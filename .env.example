ANTHROPIC_API_KEY=
# Competitor lane (/ads_archive). Needs an app allow-listed for the Ad Library.
META_AD_LIBRARY_ACCESS_TOKEN=
# Owned-account lane (perf-ingest / perf-series). Needs ads_read on the act_*.
# A different credential from the one above — each app is refused by the other's
# endpoints with `(#10) Application does not have permission`. Falls back to
# META_AD_LIBRARY_ACCESS_TOKEN when unset. A system user token here never expires.
META_OWNED_ACCESS_TOKEN=
# Optional: SerpApi key for Google Ads Transparency Center ingestion. If unset,
# google_ads sources fall back to a Playwright scrape of the ATC. (GOOGLE_ATC_API_KEY
# is also accepted as an alias.)
SERPAPI_API_KEY=
# Optional: iSpot.tv enterprise API key for TV-ad ingestion. If unset, tv_ads
# sources scrape iSpot's public brand pages (creative + airings + ranks; dollar
# spend / impressions / SOV are masked for anonymous users and need this key).
ISPOT_API_KEY=
INTEL_DATA_DIR=./data
INTEL_DB_PATH=./data/intel.db
INTEL_MODEL=claude-opus-4-7
INTEL_VISION_MODEL=claude-sonnet-4-6
