ANTHROPIC_API_KEY=
# Competitor lane (/ads_archive). Needs an app allow-listed for the Ad Library.
META_AD_LIBRARY_ACCESS_TOKEN=
# Owned-account lane (perf-ingest / perf-series). Needs ads_read on the act_*.
# A different credential from the one above — each app is refused by the other's
# endpoints with `(#10) Application does not have permission`. Falls back to
# META_AD_LIBRARY_ACCESS_TOKEN when unset. A system user token here never expires.
META_OWNED_ACCESS_TOKEN=
# Optional: SerpApi key for Google Ads Transparency Center ingestion. If unset,
# google_ads sources fall back to a Playwright scrape of the ATC. (GOOGLE_ATC_API_KEY
# is also accepted as an alias.)
SERPAPI_API_KEY=
# Optional: iSpot.tv enterprise API key for TV-ad ingestion. If unset, tv_ads
# sources scrape iSpot's public brand pages (creative + airings + ranks; dollar
# spend / impressions / SOV are masked for anonymous users and need this key).
ISPOT_API_KEY=
# S3 asset hosting for dashboards (scripts/s3_assets.py; see S3_ASSETS.md).
# Required by scripts/refresh_spectrum_perf.sh's S3 step; harmless to leave as
# the defaults below unless you're pointing at a different bucket/prefix.
# AWS_S3_PREFIX is a BASE prefix shared across clients — a client segment is
# appended automatically from each deployment's data/<client>_assets dirname,
# so per-client objects never need a separate var or flag.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are deliberately NOT here — they
# come from the standard boto3 credential chain (export them separately,
# ~/.aws/credentials, or an instance role), never from a repo-tracked file.
AWS_REGION=us-east-1
AWS_S3_BUCKET=next-ext-commerce-us-east-1
AWS_S3_PREFIX=outbound/competitive-intel
# Netlify CLI (scripts/deploy_netlify.sh). Set this to skip interactive
# `netlify login` — a personal or team access token from
# app.netlify.com/user/applications. Without it, deploy_netlify.sh still
# works, but needs a one-time `netlify login` in a browser first.
# NETLIFY_SITE_ID is NOT needed here — .netlify/state.json (gitignored,
# already present in this repo) already links this checkout to the site.
NETLIFY_AUTH_TOKEN=
INTEL_DATA_DIR=./data
INTEL_DB_PATH=./data/intel.db
INTEL_MODEL=claude-opus-4-7
INTEL_VISION_MODEL=claude-sonnet-4-6
